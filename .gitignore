# 개발 도구 메타 — 숨김 폴더 전체 (커밋하지 않음)
.plan/
.omc/
.omx/
.claude/
.playwright/
.playwright-cli/
.playwright-mcp/
.idea/
.DS_Store

# 단, .gitignore 자체와 .github/ 워크플로는 추적
!.gitignore
!.github/
!.github/**

# 빌드 바이너리 (빌드/Release로 생성 — git에 올리지 않음)
apps/sgis-*
src/bin/
src/dist/

# 환경 변수 / 시크릿
.env
scripts/.env
src/scripts/.env

# 배포 산출물
*.tar.gz
*.zip

# 스크래핑 중간 산출물 (정본: references/sgis-endpoints.md)
sgis-raw.json
